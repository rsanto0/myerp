{
	"info": {
		"name": "Auth Service - Standalone",
		"description": "Testes isolados do Auth Service",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "auth_base_url",
			"value": "http://localhost:8081",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "🔐 Autenticação",
			"item": [
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('jwt_token', response.token);",
									"    pm.test('Token capturado', () => {",
									"        pm.expect(response.token).to.not.be.empty;",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{auth_base_url}}/auth/login",
							"host": ["{{auth_base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Login Funcionário",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"login\": \"funcionario\",\n  \"senha\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{auth_base_url}}/auth/login",
							"host": ["{{auth_base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Validar Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{auth_base_url}}/auth/validate",
							"host": ["{{auth_base_url}}"],
							"path": ["auth", "validate"]
						}
					}
				}
			]
		},
		{
			"name": "👥 Usuários",
			"item": [
				{
					"name": "Criar Usuário Funcionário",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"login\": \"novo.funcionario\",\n  \"senha\": \"senha123\",\n  \"nome\": \"Novo Funcionário\",\n  \"cpf\": \"12345678901\",\n  \"role\": \"FUNCIONARIO\"\n}"
						},
						"url": {
							"raw": "{{auth_base_url}}/auth/users",
							"host": ["{{auth_base_url}}"],
							"path": ["auth", "users"]
						}
					}
				},
				{
					"name": "Criar Usuário Admin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"login\": \"novo.admin\",\n  \"senha\": \"admin456\",\n  \"nome\": \"Novo Administrador\",\n  \"cpf\": \"98765432100\",\n  \"role\": \"ADMIN\"\n}"
						},
						"url": {
							"raw": "{{auth_base_url}}/auth/users",
							"host": ["{{auth_base_url}}"],
							"path": ["auth", "users"]
						}
					}
				}
			]
		},
		{
			"name": "🔍 Health Check",
			"item": [
				{
					"name": "Health",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{auth_base_url}}/actuator/health",
							"host": ["{{auth_base_url}}"],
							"path": ["actuator", "health"]
						}
					}
				},
				{
					"name": "Info",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{auth_base_url}}/actuator/info",
							"host": ["{{auth_base_url}}"],
							"path": ["actuator", "info"]
						}
					}
				}
			]
		}
	]
}