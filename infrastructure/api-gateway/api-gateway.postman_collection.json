{
	"info": {
		"name": "API Gateway - Standalone",
		"description": "Testes isolados do API Gateway",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "gateway_base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "🔐 Auth Routes (Público)",
			"item": [
				{
					"name": "Login via Gateway",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('jwt_token', response.token);",
									"    pm.test('Token capturado via Gateway', () => {",
									"        pm.expect(response.token).to.not.be.empty;",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{gateway_base_url}}/auth/login",
							"host": ["{{gateway_base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Validar Token via Gateway",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_base_url}}/auth/validate",
							"host": ["{{gateway_base_url}}"],
							"path": ["auth", "validate"]
						}
					}
				},
				{
					"name": "Criar Usuário via Gateway",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"login\": \"gateway.test\",\n  \"senha\": \"senha123\",\n  \"nome\": \"Usuário Gateway Test\",\n  \"cpf\": \"11122233344\",\n  \"role\": \"FUNCIONARIO\"\n}"
						},
						"url": {
							"raw": "{{gateway_base_url}}/auth/users",
							"host": ["{{gateway_base_url}}"],
							"path": ["auth", "users"]
						}
					}
				}
			]
		},
		{
			"name": "🛡️ Protected Routes (JWT)",
			"item": [
				{
					"name": "Registrar Ponto via Gateway",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_base_url}}/api/pontos/1/registrar",
							"host": ["{{gateway_base_url}}"],
							"path": ["api", "pontos", "1", "registrar"]
						}
					}
				},
				{
					"name": "Listar Pontos via Gateway",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_base_url}}/api/pontos/1",
							"host": ["{{gateway_base_url}}"],
							"path": ["api", "pontos", "1"]
						}
					}
				}
			]
		},
		{
			"name": "🔧 Admin Routes (JWT + ADMIN)",
			"item": [
				{
					"name": "Listar Funcionários via Gateway",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_base_url}}/api/admin/funcionarios",
							"host": ["{{gateway_base_url}}"],
							"path": ["api", "admin", "funcionarios"]
						}
					}
				},
				{
					"name": "Criar Funcionário via Gateway",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Funcionário Gateway\",\n  \"cpf\": \"55566677788\",\n  \"login\": \"func.gateway\",\n  \"senha\": \"1234\",\n  \"role\": \"FUNCIONARIO\"\n}"
						},
						"url": {
							"raw": "{{gateway_base_url}}/api/admin/funcionarios",
							"host": ["{{gateway_base_url}}"],
							"path": ["api", "admin", "funcionarios"]
						}
					}
				},
				{
					"name": "Listar Todos os Pontos via Gateway",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_base_url}}/api/admin/pontos",
							"host": ["{{gateway_base_url}}"],
							"path": ["api", "admin", "pontos"]
						}
					}
				}
			]
		},
		{
			"name": "🔍 Gateway Health",
			"item": [
				{
					"name": "Gateway Health",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{gateway_base_url}}/actuator/health",
							"host": ["{{gateway_base_url}}"],
							"path": ["actuator", "health"]
						}
					}
				},
				{
					"name": "Gateway Routes",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{gateway_base_url}}/actuator/gateway/routes",
							"host": ["{{gateway_base_url}}"],
							"path": ["actuator", "gateway", "routes"]
						}
					}
				}
			]
		}
	]
}