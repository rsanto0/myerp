{
	"info": {
		"name": "Biometria Module - Standalone",
		"description": "Testes isolados do Biometria Module",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "biometria_base_url",
			"value": "http://localhost:8083",
			"type": "string"
		},
		{
			"key": "config_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "usuario_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "📷 Configuração de Câmeras",
			"item": [
				{
					"name": "Criar Config USB",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.configId) {",
									"        pm.collectionVariables.set('config_id', response.configId);",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nomeConfiguracao\": \"Camera USB Principal\",\n  \"alias\": \"camera_entrada\",\n  \"tipoCamera\": \"USB\",\n  \"marcaModelo\": \"Logitech C920\",\n  \"resolucao\": \"1920x1080\",\n  \"indiceUsb\": 0,\n  \"fps\": 30,\n  \"qualidadeJpeg\": 80\n}"
						},
						"url": {
							"raw": "{{biometria_base_url}}/api/biometria/camera/config/criar",
							"host": ["{{biometria_base_url}}"],
							"path": ["api", "biometria", "camera", "config", "criar"]
						}
					}
				},
				{
					"name": "Criar Config IP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nomeConfiguracao\": \"Camera IP Saída\",\n  \"alias\": \"camera_saida\",\n  \"tipoCamera\": \"IP\",\n  \"marcaModelo\": \"Hikvision DS-2CD2043G0-I\",\n  \"resolucao\": \"2688x1520\",\n  \"enderecoIp\": \"192.168.1.100\",\n  \"porta\": 554,\n  \"protocolo\": \"RTSP\",\n  \"usuario\": \"admin\",\n  \"senha\": \"123456\",\n  \"urlStream\": \"rtsp://192.168.1.100:554/stream1\"\n}"
						},
						"url": {
							"raw": "{{biometria_base_url}}/api/biometria/camera/config/criar",
							"host": ["{{biometria_base_url}}"],
							"path": ["api", "biometria", "camera", "config", "criar"]
						}
					}
				},
				{
					"name": "Listar Configurações",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{biometria_base_url}}/api/biometria/camera/config/listar",
							"host": ["{{biometria_base_url}}"],
							"path": ["api", "biometria", "camera", "config", "listar"]
						}
					}
				},
				{
					"name": "Testar Configuração",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{biometria_base_url}}/api/biometria/camera/config/testar/{{config_id}}",
							"host": ["{{biometria_base_url}}"],
							"path": ["api", "biometria", "camera", "config", "testar", "{{config_id}}"]
						}
					}
				},
				{
					"name": "Ativar Configuração",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{biometria_base_url}}/api/biometria/camera/config/ativar/{{config_id}}",
							"host": ["{{biometria_base_url}}"],
							"path": ["api", "biometria", "camera", "config", "ativar", "{{config_id}}"]
						}
					}
				},
				{
					"name": "Config Ativa",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{biometria_base_url}}/api/biometria/camera/config/ativa",
							"host": ["{{biometria_base_url}}"],
							"path": ["api", "biometria", "camera", "config", "ativa"]
						}
					}
				}
			]
		},
		{
			"name": "🔧 Gerenciamento de Câmeras",
			"item": [
				{
					"name": "Atualizar Configuração",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"alias\": \"camera_entrada_principal\",\n  \"resolucao\": \"4K\",\n  \"fps\": 60,\n  \"qualidadeJpeg\": 90\n}"
						},
						"url": {
							"raw": "{{biometria_base_url}}/api/biometria/camera/manage/atualizar/{{config_id}}",
							"host": ["{{biometria_base_url}}"],
							"path": ["api", "biometria", "camera", "manage", "atualizar", "{{config_id}}"]
						}
					}
				},
				{
