					"name": "Listar por Tipo",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{biometria_base_url}}/api/biometria/camera/manage/listar-tipo/USB",
							"host": ["{{biometria_base_url}}"],
							"path": ["api", "biometria", "camera", "manage", "listar-tipo", "USB"]
