					}
				},
				{
					"name": "Remover Configuração",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{biometria_base_url}}/api/biometria/camera/manage/remover/2",
							"host": ["{{biometria_base_url}}"],
							"path": ["api", "biometria", "camera", "manage", "remover", "2"]
						}
					}
				}
			]
		},
		{
			"name": "🎥 Captura Biométrica",
			"item": [
				{
					"name": "Testar Câmera",
