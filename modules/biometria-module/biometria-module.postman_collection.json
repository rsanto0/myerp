						"method": "GET",
						"url": {
							"raw": "{{biometria_base_url}}/api/biometria/camera/manage/buscar-alias/camera_entrada",
							"host": ["{{biometria_base_url}}"],
							"path": ["api", "biometria", "camera", "manage", "buscar-alias", "camera_entrada"]
						}
					}
				},
