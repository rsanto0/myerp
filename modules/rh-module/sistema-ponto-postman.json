					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-save funcionario ID from login response",
					"if (pm.response.code === 200 && pm.request.url.toString().includes('/funcionarios/login')) {",
					"    const response = pm.response.json();",
					"    if (response.id) {",
					"        pm.environment.set('funcionario_id', response.id);",
					"        console.log('Funcionario ID saved to environment');",
					"    }",
					"}",
					"",
					"// Auto-save admin ID from login response", 
					"if (pm.response.code === 200 && pm.request.url.toString().includes('/admin/login')) {",
					"    const response = pm.response.json();",
					"    if (response.id) {",
					"        pm.environment.set('admin_id', response.id);",
					"        console.log('Admin ID saved to environment');",
					"    }",
					"}"
				]
			}
		}
