		},
		{
			"name": "🔍 Health Check",
			"item": [
				{
					"name": "Health",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{financial_base_url}}/actuator/health",
							"host": ["{{financial_base_url}}"],
							"path": ["actuator", "health"]
						}
