						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"razaoSocial\": \"Empresa Teste Ltda\",\n  \"nomeFantasia\": \"Empresa Teste\",\n  \"cnpj\": \"12.345.678/0001-99\",\n  \"endereco\": \"Rua Teste, 123\",\n  \"cidade\": \"São Paulo\",\n  \"estado\": \"SP\",\n  \"cep\": \"01234-567\",\n  \"telefone\": \"(11) 1234-5678\",\n  \"email\": \"contato@empresateste.com.br\",\n  \"tipoPlano\": \"BASIC\"\n}"
						},
