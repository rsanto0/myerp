						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.empresa && response.empresa.id) {",
									"        pm.collectionVariables.set('empresa_id', response.empresa.id);",
									"    }",
									"}"
								]
							}
						}
					],
