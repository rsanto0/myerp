{
	"info": {
		"_postman_id": "myerp-tests-collection",
		"name": "MyERP - Testes Automatizados",
		"description": "Collection com fluxos de teste automatizados para validar o sistema completo",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🔄 Fluxo Completo - Funcionário",
			"item": [
				{
					"name": "1. Login Funcionário",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login realizado com sucesso', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Token JWT retornado', function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.token).to.not.be.empty;",
									"    pm.environment.set('jwt_token_funcionario', response.token);",
									"    pm.environment.set('funcionario_id', response.userId);",
									"});",
									"",
									"pm.test('Role é FUNCIONARIO', function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.role).to.eql('FUNCIONARIO');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"login\": \"funcionario\",\n  \"senha\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "2. Registrar Ponto",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Ponto registrado com sucesso', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Resposta contém dados do registro', function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.id).to.not.be.undefined;",
									"    pm.expect(response.tipo).to.not.be.empty;",
									"    pm.expect(response.dataHora).to.not.be.empty;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token_funcionario}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/pontos/{{funcionario_id}}/registrar",
							"host": ["{{base_url}}"],
							"path": ["api", "pontos", "{{funcionario_id}}", "registrar"]
						}
					}
				},
				{
					"name": "3. Consultar Próprios Pontos",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Consulta realizada com sucesso', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Lista de pontos retornada', function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.be.an('array');",
									"    pm.expect(response.length).to.be.greaterThan(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token_funcionario}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/pontos/{{funcionario_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "pontos", "{{funcionario_id}}"]
						}
					}
				},
				{
					"name": "4. Tentar Acessar Área Admin (Deve Falhar)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Acesso negado para funcionário', function () {",
									"    pm.response.to.have.status(403);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token_funcionario}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/admin/funcionarios",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "funcionarios"]
						}
					}
				}
			],
			"description": "Fluxo completo de teste para funcionário comum"
		},
