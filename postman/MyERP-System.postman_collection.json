						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"João Silva\",\n  \"cpf\": \"12345678901\",\n  \"login\": \"joao\",\n  \"senha\": \"123456\",\n  \"role\": \"FUNCIONARIO\"\n}"
