								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:8080/auth/validate",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["auth", "validate"]
						},
						"description": "Valida se o token JWT está válido"
					}
				},
				{
					"name": "Criar Usuário",
					"request": {
						"method": "POST",
