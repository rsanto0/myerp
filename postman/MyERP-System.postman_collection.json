	"item": [
		{
			"name": "🔐 1. Auth Service",
			"item": [
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('jwt_token', response.token);",
									"    pm.environment.set('user_id', response.userId);",
									"    pm.environment.set('user_role', response.role);",
									"    console.log('Token JWT salvo:', response.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"admin123\"\n}"
						},
						"url": {
							"raw": "http://localhost:8080/auth/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["auth", "login"]
						},
						"description": "Login do administrador - salva token automaticamente"
					}
				},
				{
					"name": "Login Funcionário",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('jwt_token_funcionario', response.token);",
									"    pm.environment.set('funcionario_id', response.userId);",
									"    console.log('Token Funcionário salvo:', response.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"login\": \"funcionario\",\n  \"senha\": \"123456\"\n}"
						},
						"url": {
