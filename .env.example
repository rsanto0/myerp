# Exemplo de variáveis de ambiente para deploy
# Copie para .env e ajuste os valores

# Profile ativo (local, docker, prod)
SPRING_PROFILES_ACTIVE=local

# Portas dos serviços
SERVER_PORT=8084
EUREKA_PORT=8761
GATEWAY_PORT=8080
AUTH_PORT=8081
RH_PORT=8082
BIOMETRIA_PORT=8083

# Hosts dos serviços
EUREKA_HOST=localhost
GATEWAY_HOST=localhost
AUTH_HOST=localhost
RH_HOST=localhost
BIOMETRIA_HOST=localhost

# URLs completas (alternativa)
EUREKA_URL=http://localhost:8761/eureka/

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biometria_db
DB_USER=myerp_user
DB_PASS=myerp_pass